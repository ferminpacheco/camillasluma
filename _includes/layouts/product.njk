---
layout: base.njk
---
{{ content | safe }}

{% if schemaProduct %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "{{ canonical }}#product",
      "name": "{{ schemaProduct.name }}",
      "description": "{{ schemaProduct.description }}",
      "brand": {
        "@type": "Brand",
        "name": "LUMA"
      },
      "image": "{{ site.url }}{{ schemaProduct.image }}",
      "url": "{{ canonical }}",
      "manufacturer": {
        "@id": "{{ site.url }}/#organization"
      }
    }
    {% if schemaFaqs %},
    {
      "@type": "FAQPage",
      "@id": "{{ canonical }}#faq",
      "mainEntity": [
        {% for faq in schemaFaqs %}
        {
          "@type": "Question",
          "name": "{{ faq.q }}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{ faq.a }}"
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
    {% endif %}
  ]
}
</script>
{% endif %}
