---
layout: base.njk
---
{% include "components/breadcrumb.njk" %}

{{ content | safe }}

{% if schemaProduct %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonical }}#breadcrumb",
      "itemListElement": [
        {% for crumb in breadcrumbs %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ crumb.label }}"{% if crumb.url %},
          "item": "{{ site.url }}{{ crumb.url }}"{% endif %}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    },
    {
      "@type": "Product",
      "@id": "{{ canonical }}#product",
      "name": "{{ schemaProduct.name }}",
      "description": "{{ schemaProduct.description }}",
      "brand": {
        "@type": "Brand",
        "name": "LUMA"
      },
      "image": "{{ site.url }}{{ schemaProduct.image }}",
      "url": "{{ canonical }}",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "USD",
        "price": "{{ schemaProduct.price }}",
        "priceValidUntil": "2026-12-31",
        "availability": "{% if schemaProduct.outOfStock %}https://schema.org/OutOfStock{% else %}https://schema.org/InStock{% endif %}",
        "seller": {
          "@id": "{{ site.url }}/#organization"
        }
      },
      "manufacturer": {
        "@id": "{{ site.url }}/#organization"
      }
    }
    {% if schemaFaqs %},
    {
      "@type": "FAQPage",
      "@id": "{{ canonical }}#faq",
      "mainEntity": [
        {% for faq in schemaFaqs %}
        {
          "@type": "Question",
          "name": "{{ faq.q }}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{ faq.a }}"
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
    {% endif %}
  ]
}
</script>
{% endif %}
