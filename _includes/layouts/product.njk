---
layout: base.njk
---
{{ content | safe }}

{% if schemaProduct %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "{{ canonical }}#product",
      "name": "{{ schemaProduct.name }}",
      "description": "{{ schemaProduct.description }}",
      "brand": {
        "@type": "Brand",
        "name": "LUMA"
      },
      "image": "{{ site.url }}{{ schemaProduct.image }}",
      "url": "{{ canonical }}",
      "manufacturer": {
        "@id": "{{ site.url }}/#organization"
      }
    }
    {% set faqsSchema = faqs | faqsVisibles %}
    {% if faqsSchema.length %},
    {
      "@type": "FAQPage",
      "@id": "{{ canonical }}#faq",
      "mainEntity": [
        {% for faq in faqsSchema %}
        {
          "@type": "Question",
          "name": {{ faq.q | dump | safe }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq.a | textoPlano | dump | safe }}
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
    {% endif %}
  ]
}
</script>
{% endif %}
