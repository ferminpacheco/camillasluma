<section class="bloque-showroom" id="showrooms">
  {# El wrapper interno replica .nosotros-seccion-inner (1100px centrado).
     Sin él el h2 arrancaba al 5% del viewport y quedaba ~300px a la izquierda
     del resto de los títulos de la página. #}
  <div class="bloque-showroom-inner">
    <h2>Vení a probarla</h2>
    <p>Dos showrooms en CABA con turno previo. Probá la camilla antes de decidir.</p>

    <div class="showroom-grid">

      <div class="showroom-card">
        <img
          src="/images/showroom-palermo.png"
          alt="Showroom LUMA en Palermo, CABA — camillas eléctricas en exhibición"
          class="showroom-card-imagen"
          width="2000"
          height="2000"
          loading="lazy"
        >
        <div class="showroom-card-body">
          <h3>Palermo, CABA</h3>
          <a
            {# Cada showroom manda su propio mensaje: el CTA dice "Agendá tu
               visita", el chat tiene que arrancar diciendo eso y de cuál. #}
            href="{{ 'Hola! Quiero agendar una visita al showroom de Palermo.' | waLink }}"
            class="cta-button-light"
            target="_blank"
            rel="noopener"
            data-track="showroom_click"
          >Agendá tu visita</a>
        </div>
      </div>

      <div class="showroom-card">
        <img
          src="/images/showroom-belgrano-1x1.webp"
          alt="Showroom LUMA en Belgrano, CABA — camillas eléctricas en exhibición"
          class="showroom-card-imagen"
          width="510"
          height="510"
          loading="lazy"
        >
        <div class="showroom-card-body">
          <h3>Belgrano, CABA</h3>
          <a
            {# Cada showroom manda su propio mensaje: el CTA dice "Agendá tu
               visita", el chat tiene que arrancar diciendo eso y de cuál. #}
            href="{{ 'Hola! Quiero agendar una visita al showroom de Belgrano.' | waLink }}"
            class="cta-button-light"
            target="_blank"
            rel="noopener"
            data-track="showroom_click"
          >Agendá tu visita</a>
        </div>
      </div>

    </div>
  </div>
</section>
