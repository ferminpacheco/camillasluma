---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {#
    Sitemap dinámico: sale de `collections.all`, así una página nueva entra
    sola y una borrada sale sola. Quedan afuera:
      - las que declaran `noindex: true` o `sitemapExclude: true`;
      - /404.html y este archivo (eleventyExcludeFromCollections);
      - el blog, que se maneja aparte más abajo.
    <lastmod> viene del filtro `lastmod` (.eleventy.js): front matter
    `updated`/`date` si existe, si no la fecha del último commit del archivo.
    changefreq/priority se asignan por patrón de URL.
  #}
  {%- for p in collections.all -%}
    {%- set url = p.url -%}
    {%- set excluida = p.data.noindex or p.data.sitemapExclude or (url and url.startsWith("/blog/")) -%}
    {%- if url and not excluida %}
    {%- if url == "/" -%}
      {%- set prio = "1.0" -%}
    {%- elif url.startsWith("/camillas-electricas/") -%}
      {%- set prio = "0.9" -%}
    {%- elif url.startsWith("/carritos-auxiliares/") or url == "/luminarias/" -%}
      {%- set prio = "0.8" -%}
    {%- else -%}
      {%- set prio = "0.7" -%}
    {%- endif %}
  <url>
    <loc>{{ site.url }}{{ url }}</loc>
    <lastmod>{{ p.page | lastmod(p.data) }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>{{ prio }}</priority>
  </url>
    {%- endif -%}
  {%- endfor %}
  {#
    Blog: el hub y los posts entran solo si hay al menos un post en la
    colección `posts`. Así un hub vacío no llega al sitemap, y cuando se
    publique el primer artículo entran los dos sin tocar este archivo.
  #}
  {%- if collections.posts and collections.posts.length %}
  <url>
    <loc>{{ site.url }}/blog/</loc>
    <lastmod>{{ collections.posts[0].page | lastmod(collections.posts[0].data) }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  {%- for post in collections.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.page | lastmod(post.data) }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {%- endfor %}
  {%- endif %}
</urlset>
