---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {# OJO: los comentarios Nunjucks no pueden ir DENTRO del {% raw %}{% set %}{% endraw %}
     de abajo — rompen el parseo de la expresion. #}
  {% set pages = [
    { url: "/", changefreq: "monthly", priority: "1.0" },
    { url: "/camillas-electricas/", changefreq: "monthly", priority: "0.9" },
    { url: "/camillas-electricas/premium/", changefreq: "monthly", priority: "0.9" },
    { url: "/camillas-electricas/luma-gold/", changefreq: "monthly", priority: "0.9" },
    { url: "/camillas-electricas/one/", changefreq: "monthly", priority: "0.9" },
    { url: "/camillas-electricas/ginecologica/", changefreq: "monthly", priority: "0.9" },
    { url: "/carritos-auxiliares/", changefreq: "monthly", priority: "0.8" },
    { url: "/carritos-auxiliares/luma-cart/", changefreq: "monthly", priority: "0.8" },
    { url: "/carritos-auxiliares/luma-tech/", changefreq: "monthly", priority: "0.8" },
    { url: "/luminarias/", changefreq: "monthly", priority: "0.8" },
    { url: "/nosotros/", changefreq: "monthly", priority: "0.7" },
    { url: "/garantia/", changefreq: "monthly", priority: "0.7" },
    { url: "/blog/", changefreq: "weekly", priority: "0.6" }
  ] %}
  {% for p in pages %}
  <url>
    <loc>https://camillasluma.com{{ p.url }}</loc>
    <changefreq>{{ p.changefreq }}</changefreq>
    <priority>{{ p.priority }}</priority>
  </url>
  {% endfor %}
  {# Posts del blog: salen de la coleccion, no hay que registrarlos a mano. #}
  {% for post in collections.posts %}
  <url>
    <loc>https://camillasluma.com{{ post.url }}</loc>
    <lastmod>{{ (post.data.updated or post.date) | htmlDateString }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
</urlset>
