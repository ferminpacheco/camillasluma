    { url: "/carritos-auxiliares/luma-tech/", changefreq: "monthly", priority: "0.8" },
    { url: "/carritos-auxiliares/cart-gold/", changefreq: "monthly", priority: "0.8" },
    { url: "/luminarias/", changefreq: "monthly", priority: "0.8" },
